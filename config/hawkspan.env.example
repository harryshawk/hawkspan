# Copy to ~/.hawkspan/hawkspan.env and run: chmod 600 ~/.hawkspan/hawkspan.env
HAWKSPAN_NODE_ID=working-mac
HAWKSPAN_PLUGIN_ROOT=/Users/localuser/plugins/hawkspan
HAWKSPAN_APPLICATION_PLUGIN_ROOT=/Users/localuser/.hawkspan/plugins
HAWKSPAN_PEER_NODE_ID=worker-mac
HAWKSPAN_PEER_USER=peeruser
HAWKSPAN_PEER_THREAD_ID=replace-only-when-wakeups-are-enabled
HAWKSPAN_REMOTE_NODE=/usr/local/bin/node
HAWKSPAN_REMOTE_PLUGIN_ROOT=/Users/peeruser/plugins/hawkspan
HAWKSPAN_REMOTE_CALL_TOOL=/Users/peeruser/plugins/hawkspan/scripts/call-tool.mjs
HAWKSPAN_PRIMARY_ENABLED=true
HAWKSPAN_PRIMARY_LABEL=Thunderbolt
HAWKSPAN_PRIMARY_HOST=192.0.2.10
HAWKSPAN_FALLBACK_ENABLED=true
HAWKSPAN_FALLBACK_LABEL=Ethernet
HAWKSPAN_FALLBACK_HOST=198.51.100.10
HAWKSPAN_SSH_IDENTITY=/Users/localuser/.ssh/hawkspan_peer
HAWKSPAN_REMOTE_INBOX=/Users/peeruser/.hawkspan/inbox
HAWKSPAN_REMOTE_ARTIFACTS=/Users/peeruser/.hawkspan/artifacts
HAWKSPAN_REMOTE_AUDIT=/Users/peeruser/.hawkspan/audit
# Use an available loopback port for foreground validation. Choose a fixed
# nonzero port only before installing the persistent local-control agent.
HAWKSPAN_LOCAL_CONTROL_PORT=0
# Optional SimpleTuner worker integration. Omit to keep it inert.
HAWKSPAN_WORKLOAD_INBOX_ROOT=/Users/localuser/.hawkspan/workloads/inbox
HAWKSPAN_WORKLOAD_DATASET_ROOT=/Users/localuser/.hawkspan/workloads/datasets
HAWKSPAN_WORKLOAD_RECIPE_ROOT=/Users/localuser/.hawkspan/workloads/recipes
HAWKSPAN_WORKLOAD_OUTPUT_ROOT=/Users/localuser/.hawkspan/workloads/output
HAWKSPAN_WORKLOAD_STATE_ROOT=/Users/localuser/.hawkspan/workloads/state
HAWKSPAN_WORKLOAD_DISK_ROOT=/Users/localuser/.hawkspan/workloads
HAWKSPAN_WORKLOAD_RUNTIME_ROOT=/Users/localuser/.hawkspan/workloads/simpletuner-runtime
HAWKSPAN_WORKLOAD_LOG_ROOT=/Users/localuser/.hawkspan/workloads/simpletuner-runtime/logs
HAWKSPAN_SIMPLETUNER_ROOT=/Users/localuser/Applications/SimpleTuner
# Optional local trainer command adapters. Keep feature flags disabled until
# these point to reviewed HawkSpan-owned trainer commands.
HAWKSPAN_LOCAL_TRAINER_START_SCRIPT=/Users/localuser/.hawkspan/plugins/application-workflows/bin/hawkspan-trainer-start.sh
HAWKSPAN_LOCAL_TRAINER_STOP_SCRIPT=/Users/localuser/.hawkspan/plugins/application-workflows/bin/hawkspan-trainer-stop.sh
HAWKSPAN_LOCAL_TRAINER_PACKAGE_SCRIPT=/Users/localuser/.hawkspan/plugins/application-workflows/bin/hawkspan-trainer-package.sh
# Optional real-workflow acceptance input. Keep the copied file mode 0600.
# Optional. Created only by scripts/record-owner-assisted-fallback.mjs during
# an owner-observed primary interruption and restoration.
# HAWKSPAN_REAL_PAIR_FALLBACK_EVIDENCE=/Users/localuser/.hawkspan/acceptance/fallback-evidence.json
