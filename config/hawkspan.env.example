# Copy to ~/.hawkspan/hawkspan.env and run: chmod 600 ~/.hawkspan/hawkspan.env
HAWKSPAN_NODE_ID=working-mac
HAWKSPAN_ACTIVE_RELEASE_ROOT=/Users/localuser/.local/share/hawkspan/releases/RELEASE_REVISION
HAWKSPAN_APPLICATION_PLUGIN_ROOT=/Users/localuser/.hawkspan/plugins
HAWKSPAN_PEER_NODE_ID=worker-mac
HAWKSPAN_PEER_USER=peeruser
HAWKSPAN_PEER_THREAD_ID=replace-only-when-wakeups-are-enabled
HAWKSPAN_REMOTE_NODE=/usr/local/bin/node
HAWKSPAN_REMOTE_STATE_DIR=/Users/peeruser/.hawkspan
HAWKSPAN_PRIMARY_ENABLED=true
HAWKSPAN_PRIMARY_LABEL=Thunderbolt
HAWKSPAN_PRIMARY_LOCAL_HOST=192.0.2.9
HAWKSPAN_PRIMARY_HOST=192.0.2.10
HAWKSPAN_FALLBACK_ENABLED=true
HAWKSPAN_FALLBACK_LABEL=Ethernet
HAWKSPAN_FALLBACK_LOCAL_HOST=198.51.100.9
HAWKSPAN_FALLBACK_HOST=198.51.100.10
HAWKSPAN_SSH_IDENTITY=/Users/localuser/.ssh/hawkspan_peer
HAWKSPAN_REMOTE_INBOX=/Users/peeruser/.hawkspan/inbox
HAWKSPAN_REMOTE_ARTIFACTS=/Users/peeruser/.hawkspan/artifacts
HAWKSPAN_REMOTE_AUDIT=/Users/peeruser/.hawkspan/audit
# Use an available loopback port for foreground validation. Choose a fixed
# nonzero port only before installing the persistent local-control agent.
HAWKSPAN_LOCAL_CONTROL_PORT=0
# Optional approved local trainer workflow. These values configure paths only;
# HawkSpan does not install or modify SimpleTuner.
HAWKSPAN_WORKLOAD_INBOX_ROOT=/Users/localuser/.hawkspan/workloads/inbox
HAWKSPAN_WORKLOAD_DATASET_ROOT=/Users/localuser/.hawkspan/workloads/datasets
HAWKSPAN_WORKLOAD_RECIPE_ROOT=/Users/localuser/.hawkspan/workloads/recipes
HAWKSPAN_WORKLOAD_OUTPUT_ROOT=/Users/localuser/.hawkspan/workloads/output
HAWKSPAN_WORKLOAD_STATE_ROOT=/Users/localuser/.hawkspan/workloads/state
HAWKSPAN_WORKLOAD_DISK_ROOT=/Users/localuser/.hawkspan/workloads
HAWKSPAN_WORKLOAD_RUNTIME_ROOT=/Users/localuser/.hawkspan/workloads/runtime
HAWKSPAN_WORKLOAD_LOG_ROOT=/Users/localuser/.hawkspan/workloads/runtime/logs
HAWKSPAN_SIMPLETUNER_ROOT=/Users/localuser/Applications/SimpleTuner
HAWKSPAN_LOCAL_TRAINER_START_SCRIPT=/Users/localuser/.hawkspan/bin/trainer-start
HAWKSPAN_LOCAL_TRAINER_STOP_SCRIPT=/Users/localuser/.hawkspan/bin/trainer-stop
HAWKSPAN_LOCAL_TRAINER_PACKAGE_SCRIPT=/Users/localuser/.hawkspan/bin/trainer-package
# Layered startup/readiness monitor. These bounded retries distinguish local
# route config, peer ping, SSH port, SSH login, remote HawkSpan, and trainer
# readiness. Keep these in hawkspan.env so the control panel can expose them.
HAWKSPAN_READINESS_LOCAL_CONFIG_TIMEOUT_MS=10000
HAWKSPAN_READINESS_PEER_PING_TIMEOUT_MS=60000
HAWKSPAN_READINESS_SSH_PORT_TIMEOUT_MS=90000
HAWKSPAN_READINESS_SSH_LOGIN_TIMEOUT_MS=120000
HAWKSPAN_READINESS_AGENT_TIMEOUT_MS=90000
HAWKSPAN_READINESS_TRAINER_TIMEOUT_MS=60000
HAWKSPAN_READINESS_TOTAL_TIMEOUT_MS=300000
HAWKSPAN_READINESS_RETRY_DELAYS_MS=2000,3000,5000,8000
# Generic queue registry and persistent application-layer supervision.
HAWKSPAN_QUEUE_SUPERVISOR_ENABLED=true
HAWKSPAN_QUEUE_SUPERVISOR_POLL_INTERVAL_MS=120000
HAWKSPAN_QUEUE_WORKER_RESTART_DELAYS_MS=2000,5000,10000,20000
HAWKSPAN_QUEUE_ITEM_LEASE_MS=300000
HAWKSPAN_QUEUE_MAX_ITEMS_PER_WORKER=10
HAWKSPAN_QUEUE_DEFAULT_MAXIMUM_ATTEMPTS=5
HAWKSPAN_QUEUE_DEFAULT_MAX_PENDING_ITEMS=10000
HAWKSPAN_QUEUE_DEFAULT_MAX_PAYLOAD_BYTES=1048576
HAWKSPAN_QUEUE_RETRY_JITTER=true
HAWKSPAN_PACKAGE_RETURN_LOCK_WAIT_MS=30000
HAWKSPAN_SIMPLETUNER_STATE_LOCK_WAIT_MS=30000
# TB-primary/Ethernet-fallback delivery retries used by messages and files.
HAWKSPAN_LINK_OPERATION_RETRY_DELAYS_MS=2000,5000,10000,20000
HAWKSPAN_LINK_OPERATION_ATTEMPT_TIMEOUT_MS=15000
HAWKSPAN_LINK_CONNECT_TIMEOUT_MS=5000
HAWKSPAN_LINK_CYCLE_TIMEOUT_MS=120000
HAWKSPAN_LINK_SERVER_ALIVE_INTERVAL_SECONDS=15
HAWKSPAN_LINK_SERVER_ALIVE_COUNT_MAX=3
HAWKSPAN_LINK_PRIMARY_REPROBE_MS=60000
