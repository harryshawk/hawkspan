{
  "schema_version": 1,
  "node_id": "grok-vm",
  "surface_profile": "message-files",
  "application_plugins": {
    "enabled": false
  },
  "local_control": {
    "enabled": false
  },
  "message_receiver": {
    "enabled": true,
    "start_on_mcp_server": true,
    "reconcile_interval_seconds": 30,
    "retry_backoff_seconds": [30, 60, 120, 300, 600],
    "default_target": "grok-primary",
    "targets": {
      "grok-primary": {
        "adapter": "grok",
        "command": "/home/GROK_VM_USER/.grok/downloads/grok-linux-x86_64",
        "workdir": "/home/GROK_VM_USER/HawkGrokSpan/Receiver/grok-primary",
        "session_id": "20000000-0000-0000-0000-000000000001",
        "sandbox": "off",
        "maximum_runtime_seconds": 600,
        "maximum_turns": 20
      },
      "grok-review": {
        "adapter": "grok",
        "command": "/home/GROK_VM_USER/.grok/downloads/grok-linux-x86_64",
        "workdir": "/home/GROK_VM_USER/HawkGrokSpan/Receiver/grok-review",
        "session_id": "20000000-0000-0000-0000-000000000002",
        "sandbox": "off",
        "maximum_runtime_seconds": 600,
        "maximum_turns": 20
      }
    }
  },
  "queue_supervisor": {
    "enabled": false
  },
  "transfer": {
    "allowed_artifact_roots": [
      "/home/GROK_VM_USER/HawkGrokSpan/Exchange"
    ]
  },
  "peer": {
    "node_id": "m2-hawkgrokspan",
    "user": "M2_USER",
    "allow_remote_wake": false,
    "primary_enabled": true,
    "primary_host": "M2_PRIVATE_HOST",
    "fallback_enabled": false,
    "ssh_identity": "/home/GROK_VM_USER/.ssh/hawkgrokspan_ed25519",
    "known_hosts": "/home/GROK_VM_USER/.hawkgrokspan/known_hosts",
    "transport": {
      "kind": "tailscale-nc",
      "command": "/home/GROK_VM_USER/HawkGrokSpan/bin/tailscale",
      "socket": "/home/GROK_VM_USER/HawkGrokSpan/TailscaleState/tailscaled.sock"
    },
    "remote_state_dir": "/Users/M2_USER/.hawkgrokspan",
    "remote_inbox": "/Users/M2_USER/.hawkgrokspan/inbox",
    "remote_artifacts": "/Users/M2_USER/.hawkgrokspan/artifacts",
    "remote_audit": "/Users/M2_USER/.hawkgrokspan/audit"
  },
  "features": {
    "allowed_peer_tools": {
      "inbound": [],
      "outbound": []
    },
    "allow_peer_commands": false,
    "enable_broad_run_command": false
  },
  "training": {
    "allow_start": false,
    "allow_stop": false,
    "allow_package": false
  }
}
