{
  "schema_version": 1,
  "node_id": "m2-hawkgrokspan",
  "surface_profile": "message-files",
  "application_plugins": {
    "enabled": false
  },
  "local_control": {
    "enabled": false
  },
  "message_receiver": {
    "enabled": true,
    "start_on_mcp_server": true,
    "reconcile_interval_seconds": 30,
    "retry_backoff_seconds": [30, 60, 120, 300, 600],
    "default_target": "m2-primary",
    "targets": {
      "m2-primary": {
        "adapter": "codex",
        "command": "/Applications/ChatGPT.app/Contents/Resources/codex",
        "workdir": "/Users/OWNER/HawkGrokSpan/Receiver/m2-primary",
        "session_id": "10000000-0000-0000-0000-000000000001",
        "sandbox": "workspace-write",
        "maximum_runtime_seconds": 600
      },
      "m2-review": {
        "adapter": "codex",
        "command": "/Applications/ChatGPT.app/Contents/Resources/codex",
        "workdir": "/Users/OWNER/HawkGrokSpan/Receiver/m2-review",
        "session_id": "10000000-0000-0000-0000-000000000002",
        "sandbox": "workspace-write",
        "maximum_runtime_seconds": 600
      }
    }
  },
  "queue_supervisor": {
    "enabled": false
  },
  "transfer": {
    "allowed_artifact_roots": [
      "/Users/OWNER/HawkGrokSpan/Exchange"
    ]
  },
  "peer": {
    "node_id": "grok-vm",
    "user": "GROK_VM_USER",
    "allow_remote_wake": false,
    "primary_enabled": true,
    "primary_host": "GROK_VM_PRIVATE_HOST",
    "fallback_enabled": false,
    "ssh_identity": "/Users/OWNER/.ssh/hawkgrokspan_ed25519",
    "known_hosts": "/Users/OWNER/.hawkgrokspan/known_hosts",
    "remote_state_dir": "/home/GROK_VM_USER/.hawkgrokspan",
    "remote_inbox": "/home/GROK_VM_USER/.hawkgrokspan/inbox",
    "remote_artifacts": "/home/GROK_VM_USER/.hawkgrokspan/artifacts",
    "remote_audit": "/home/GROK_VM_USER/.hawkgrokspan/audit"
  },
  "features": {
    "allowed_peer_tools": {
      "inbound": [],
      "outbound": []
    },
    "allow_peer_commands": false,
    "enable_broad_run_command": false
  },
  "training": {
    "allow_start": false,
    "allow_stop": false,
    "allow_package": false
  }
}
