<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.hawkspan.lora-scheduler</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PLUGIN_ROOT__/scripts/lora-scheduler.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HAWKSPAN_CONFIG</key>
    <string>__STATE_ROOT__/config.json</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>__STATE_ROOT__/lora-scheduler.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE_ROOT__/lora-scheduler-error.log</string>
</dict>
</plist>
