<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.hawkspan.packet-receiver</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__PLUGIN_ROOT__/scripts/m2-packet-receiver.mjs</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__STATE_ROOT__/audit/packet-receiver.log</string>
  <key>StandardErrorPath</key>
  <string>__STATE_ROOT__/audit/packet-receiver-error.log</string>
</dict>
</plist>
