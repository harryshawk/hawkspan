{
  "schema_version": 1,
  "config_name": "hawkspan-robot-acceptance-sdxl",
  "config": {
    "model_family": "sdxl",
    "model_type": "lora",
    "lora_type": "standard",
    "pretrained_model_name_or_path": "<reviewed-worker-base-model>",
    "data_backend_config": "<reviewed-worker-config-root>/hawkspan-robot-lora-v1/multidatabackend.json",
    "output_dir": "<approved-output-root>/hawkspan-robot-acceptance-run",
    "resolution": 1024,
    "train_batch_size": 1,
    "gradient_accumulation_steps": 1,
    "gradient_checkpointing": true,
    "optimizer": "adamw_bf16",
    "mixed_precision": "bf16",
    "max_train_steps": 900,
    "num_train_epochs": 0,
    "checkpoint_step_interval": 300,
    "checkpoints_total_limit": 3,
    "validation_step_interval": 300,
    "validation_prompt": "hawkspan robots, exactly two friendly companion robots posed as a polished product duo, left robot Hawk with a readable Hawk nameplate, right robot Span with a readable Span nameplate, one clearly visible glowing physical span between them, clean white and sky-blue studio, centered brand-ready composition, premium whimsical G-rated 3D render",
    "seed": 20260801,
    "learning_rate": 0.0001,
    "lr_scheduler": "constant",
    "lr_warmup_steps": 100,
    "lora_rank": 32,
    "lora_alpha": 32,
    "use_ema": false,
    "push_to_hub": false,
    "push_checkpoints_to_hub": false,
    "report_to": "none"
  }
}
