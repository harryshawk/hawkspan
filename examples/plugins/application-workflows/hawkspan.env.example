# Copy only the entries you use into ~/.hawkspan/hawkspan.env.
# The real file must be owned by the current user, mode 0600 or 0400, and never committed.
HAWKSPAN_WORKLOAD_INBOX_ROOT=/path/to/worker/inbox
HAWKSPAN_WORKLOAD_DATASET_ROOT=/path/to/worker/datasets
HAWKSPAN_WORKLOAD_RECIPE_ROOT=/path/to/worker/recipes
HAWKSPAN_WORKLOAD_OUTPUT_ROOT=/path/to/approved/simpletuner/output
HAWKSPAN_WORKLOAD_STATE_ROOT=/path/to/worker/state
HAWKSPAN_WORKLOAD_DISK_ROOT=/path/to/approved/workload-root
HAWKSPAN_WORKLOAD_RUNTIME_ROOT=/path/to/worker/simpletuner-runtime
HAWKSPAN_WORKLOAD_LOG_ROOT=/path/to/worker/simpletuner-runtime/logs
HAWKSPAN_SIMPLETUNER_ROOT=/path/to/SimpleTuner
# Optional local trainer command adapters. Keep local trainer feature flags disabled
# until these point to reviewed HawkSpan-owned trainer commands.
HAWKSPAN_LOCAL_TRAINER_START_SCRIPT=/path/to/.hawkspan/plugins/application-workflows/bin/hawkspan-trainer-start.sh
HAWKSPAN_LOCAL_TRAINER_STOP_SCRIPT=/path/to/.hawkspan/plugins/application-workflows/bin/hawkspan-trainer-stop.sh
HAWKSPAN_LOCAL_TRAINER_PACKAGE_SCRIPT=/path/to/.hawkspan/plugins/application-workflows/bin/hawkspan-trainer-package.sh
