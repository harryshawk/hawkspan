{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hawkspan.example/schemas/real-pair-receipt.schema.json",
  "title": "HawkSpan privacy-safe real-pair acceptance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "overall", "checks"],
  "properties": {
    "schema_version": { "const": 1 },
    "mode": { "const": "real-pair" },
    "overall": { "enum": ["passed", "failed"] },
    "checks": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/check" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "routes-independent" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "primary-preference" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "owner-assisted-fallback" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "mcp-list-call" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "message-receive-ack" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "remote-job-lifecycle" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "artifacts-bidirectional" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "asymmetric-controller-worker" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "installed-services-html" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "coexistence-namespace" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "rollback-readiness" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "simpletuner-live-preflight" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    }
  },
  "$defs": {
    "baseCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "assertions"],
      "properties": {
        "id": { "type": "string" },
        "status": { "enum": ["passed", "failed"] },
        "assertions": { "type": "object" },
        "failure_code": { "enum": ["adapter-error", "preflight-failed"] }
      }
    },
    "check": {
      "allOf": [
        { "$ref": "#/$defs/baseCheck" },
        {
          "oneOf": [
            { "$ref": "#/$defs/routesIndependent" },
            { "$ref": "#/$defs/primaryPreference" },
            { "$ref": "#/$defs/ownerAssistedFallback" },
            { "$ref": "#/$defs/mcpListCall" },
            { "$ref": "#/$defs/messageReceiveAck" },
            { "$ref": "#/$defs/remoteJobLifecycle" },
            { "$ref": "#/$defs/artifactsBidirectional" },
            { "$ref": "#/$defs/asymmetricControllerWorker" },
            { "$ref": "#/$defs/installedServicesHtml" },
            { "$ref": "#/$defs/coexistenceNamespace" },
            { "$ref": "#/$defs/rollbackReadiness" },
            { "$ref": "#/$defs/simpleTunerLivePreflight" }
          ]
        }
      ]
    },
    "routesIndependent": {
      "properties": {
        "id": { "const": "routes-independent" },
        "assertions": { "$ref": "#/$defs/routesIndependentAssertions" }
      }
    },
    "routesIndependentAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_route_passed", "fallback_route_passed"],
      "properties": {
        "primary_route_passed": { "type": "boolean" },
        "fallback_route_passed": { "type": "boolean" }
      }
    },
    "primaryPreference": {
      "properties": {
        "id": { "const": "primary-preference" },
        "assertions": { "$ref": "#/$defs/primaryPreferenceAssertions" }
      }
    },
    "primaryPreferenceAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_selected"],
      "properties": { "primary_selected": { "type": "boolean" } }
    },
    "ownerAssistedFallback": {
      "properties": {
        "id": { "const": "owner-assisted-fallback" },
        "assertions": { "$ref": "#/$defs/ownerAssistedFallbackAssertions" }
      }
    },
    "ownerAssistedFallbackAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_confirmed", "fallback_selected", "primary_restored"],
      "properties": {
        "owner_confirmed": { "type": "boolean" },
        "fallback_selected": { "type": "boolean" },
        "primary_restored": { "type": "boolean" }
      }
    },
    "mcpListCall": {
      "properties": {
        "id": { "const": "mcp-list-call" },
        "assertions": { "$ref": "#/$defs/mcpListCallAssertions" }
      }
    },
    "mcpListCallAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools_listed", "harmless_call_passed"],
      "properties": {
        "tools_listed": { "type": "boolean" },
        "harmless_call_passed": { "type": "boolean" }
      }
    },
    "messageReceiveAck": {
      "properties": {
        "id": { "const": "message-receive-ack" },
        "assertions": { "$ref": "#/$defs/messageReceiveAckAssertions" }
      }
    },
    "messageReceiveAckAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_received", "correlation_matched", "acknowledged"],
      "properties": {
        "message_received": { "type": "boolean" },
        "correlation_matched": { "type": "boolean" },
        "acknowledged": { "type": "boolean" }
      }
    },
    "remoteJobLifecycle": {
      "properties": {
        "id": { "const": "remote-job-lifecycle" },
        "assertions": { "$ref": "#/$defs/remoteJobLifecycleAssertions" }
      }
    },
    "remoteJobLifecycleAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["created", "authorized", "running", "completed"],
      "properties": {
        "created": { "type": "boolean" },
        "authorized": { "type": "boolean" },
        "running": { "type": "boolean" },
        "completed": { "type": "boolean" }
      }
    },
    "artifactsBidirectional": {
      "properties": {
        "id": { "const": "artifacts-bidirectional" },
        "assertions": { "$ref": "#/$defs/artifactsBidirectionalAssertions" }
      }
    },
    "artifactsBidirectionalAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_to_worker_match", "worker_to_controller_match"],
      "properties": {
        "controller_to_worker_match": { "type": "boolean" },
        "worker_to_controller_match": { "type": "boolean" }
      }
    },
    "asymmetricControllerWorker": {
      "properties": {
        "id": { "const": "asymmetric-controller-worker" },
        "assertions": { "$ref": "#/$defs/asymmetricControllerWorkerAssertions" }
      }
    },
    "asymmetricControllerWorkerAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_to_worker_allowed", "worker_to_controller_denied"],
      "properties": {
        "controller_to_worker_allowed": { "type": "boolean" },
        "worker_to_controller_denied": { "type": "boolean" }
      }
    },
    "installedServicesHtml": {
      "properties": {
        "id": { "const": "installed-services-html" },
        "assertions": { "$ref": "#/$defs/installedServicesHtmlAssertions" }
      }
    },
    "installedServicesHtmlAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link_service_ready", "html_service_ready", "html_loopback_only"],
      "properties": {
        "link_service_ready": { "type": "boolean" },
        "html_service_ready": { "type": "boolean" },
        "html_loopback_only": { "type": "boolean" }
      }
    },
    "coexistenceNamespace": {
      "properties": {
        "id": { "const": "coexistence-namespace" },
        "assertions": { "$ref": "#/$defs/coexistenceNamespaceAssertions" }
      }
    },
    "coexistenceNamespaceAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hawkspan_namespace_only", "other_products_untouched"],
      "properties": {
        "hawkspan_namespace_only": { "type": "boolean" },
        "other_products_untouched": { "type": "boolean" }
      }
    },
    "rollbackReadiness": {
      "properties": {
        "id": { "const": "rollback-readiness" },
        "assertions": { "$ref": "#/$defs/rollbackReadinessAssertions" }
      }
    },
    "rollbackReadinessAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_recorded", "state_preserved", "restore_instructions_ready"],
      "properties": {
        "revision_recorded": { "type": "boolean" },
        "state_preserved": { "type": "boolean" },
        "restore_instructions_ready": { "type": "boolean" }
      }
    },
    "simpleTunerLivePreflight": {
      "properties": {
        "id": { "const": "simpletuner-live-preflight" },
        "assertions": { "$ref": "#/$defs/simpleTunerLivePreflightAssertions" }
      }
    },
    "simpleTunerLivePreflightAssertions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_trainer_root_configured", "local_process_inspection_ready", "training_state_unchanged"],
      "properties": {
        "local_trainer_root_configured": { "type": "boolean" },
        "local_process_inspection_ready": { "type": "boolean" },
        "training_state_unchanged": { "type": "boolean" }
      }
    }
  }
}
